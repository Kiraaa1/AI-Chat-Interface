# Which provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai

# Default model per provider (override via request body if you like)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Provider API keys (only the active provider's key is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: enables Tavily as the web_search backend.
# If unset, web_search falls back to DuckDuckGo (no key required).
TAVILY_API_KEY=

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
